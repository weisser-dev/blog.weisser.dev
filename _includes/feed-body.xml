{%- assign fl = page.feed_lang -%}
{%- assign self = '/feed.xml' -%}{%- if fl == 'de' -%}{%- assign self = '/de/feed.xml' -%}{%- endif -%}
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="{{ fl }}">
  <generator uri="https://jekyllrb.com/" version="{{ jekyll.version }}">Jekyll</generator>
  <link href="{{ self | prepend: site.url }}" rel="self" type="application/atom+xml" />
  <link href="{{ '/' | prepend: site.url }}" rel="alternate" type="text/html" hreflang="en" />
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  <id>{{ self | prepend: site.url }}</id>
  <title type="html">{{ site.data.i18n[fl].feed_title | xml_escape }}</title>
  <subtitle>{{ site.description | xml_escape }}</subtitle>
  <author><name>{{ site.author.name | xml_escape }}</name></author>
{%- assign n = 0 -%}
{%- for post in site.posts -%}
  {%- include post-meta.html p=post -%}
  {%- assign vis = false -%}
  {%- if post.lang == fl or pm_alt == false -%}{%- assign vis = true -%}{%- endif -%}
  {%- if vis and n < 20 %}
  {%- assign n = n | plus: 1 %}
  <entry xml:lang="{{ post.lang }}">
    <title type="html">{{ post.title | xml_escape }}</title>
    <link href="{{ post.url | prepend: site.url }}" rel="alternate" type="text/html" hreflang="{{ post.lang }}" />
    <published>{{ post.date | date_to_xmlschema }}</published>
    <updated>{{ post.last_modified_at | default: post.date | date_to_xmlschema }}</updated>
    <id>{{ post.url | prepend: site.url }}</id>
    {%- for c in post.categories %}
    <category term="{{ c | xml_escape }}" />
    {%- endfor %}
    <summary type="html">{{ post.excerpt | strip_html | truncate: 300 | xml_escape }}</summary>
    <content type="html" xml:base="{{ post.url | prepend: site.url }}">{{ post.content | xml_escape }}</content>
  </entry>
  {%- endif -%}
{%- endfor %}
</feed>
